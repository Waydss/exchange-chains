APP_PORT=8080
APP_ENV=local
DATABASE_URL=postgres://exchange:exchange@localhost:5432/exchange?sslmode=disable
REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_DIAL_TIMEOUT=5s
REDIS_READ_TIMEOUT=2s
REDIS_WRITE_TIMEOUT=2s
REJECTED_ITEM_TTL=336h
SHUTDOWN_TIMEOUT=10s
JWT_SECRET=top-secret-sorry-icant-say
JWT_TTL=168h
GIN_MODE=debug
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_SIZE=10485760
MAX_ITEM_PHOTOS=5
STORAGE_DRIVER=local
S3_ENDPOINT=minio:9000
S3_PUBLIC_URL=http://localhost:9000/item-photos
S3_BUCKET=item-photos
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1
S3_USE_SSL=false
S3_ENSURE_BUCKET=true

POSTGRES_DB=exchange
POSTGRES_USER=exchange
POSTGRES_PASSWORD=exchange
POSTGRES_PORT=5432
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
